name = "sbsm-worker"
main = "src/index.ts"
compatibility_date = "2025-10-11"

[assets]
directory = "../frontend/out"
run_worker_first = ["/api/*", "/verify"]

[[d1_databases]]
binding = "DB"
database_name = "sbsm"
database_id = "sbsm"
migrations_dir = "../migrations"

[vars]
ADMIN_USERNAME = "admin"
# Set ADMIN_PASSWORD_HASH with `wrangler secret put` for production,
# or in an ignored .dev.vars file for local development.
