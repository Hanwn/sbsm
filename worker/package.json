{
  "name": "sbsm-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:frontend": "NEXT_PUBLIC_SBSM_SAME_ORIGIN=true npm --prefix ../frontend run build",
    "dev": "npm run build:frontend && wrangler dev",
    "deploy": "npm run build:frontend && wrangler deploy",
    "migrate": "wrangler d1 migrations apply sbsm",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js}\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240419.0",
    "prettier": "^3.2.5",
    "wrangler": "^4.42.2"
  }
}
